# 環境變數：docker compose 與本機 dotnet run（Development）共用這一份。
# 複製為 .env 後填值；.env 已列入 .gitignore，絕不進版控。
# 每個鍵的用途、格式與預設值見 docs/configuration.md。
# ⚠️ 行尾必須是 LF：CRLF 會讓每個值多一個 \r，密碼與 JWT 金鑰錯了卻不報錯。
#    檢查：file .env 出現 "with CRLF line terminators" 就是中了；修正：sed -i 's/\r$//' .env
# ⚠️ 值含 $ 時整個值用單引號包起來，否則 compose 會當成變數展開；
#    密碼避免 ; 與 '，會截斷連線字串。
# ⚠️ 必填項缺值時 compose 直接拒絕執行（${VAR:?} 語法）。填完可用
#    docker compose config 確認——它會印出實際值，不要貼到對話或 issue。

# PostgreSQL 超級使用者（只供管理；應用程式不使用）
# POSTGRES_USER 選填（預設 postgres）；POSTGRES_PASSWORD 必填
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# 應用程式專屬帳號與資料庫：volume 首次初始化時由 docker/postgres/init 的腳本建立
# ⚠️ 只在「第一次初始化」生效，之後改值不會更新既有資料庫（要重置 volume）
# 本機 dotnet run 也用這組帳密連 127.0.0.1:5432。NAME、USER 選填（預設 konbini）；PASSWORD 必填
APP_DB_NAME=konbini
APP_DB_USER=konbini
APP_DB_PASSWORD=

# JWT 簽章金鑰（必填）：至少 32 字元的隨機字串（空值或太短時 API 啟動即失敗）
# 產生：openssl rand -base64 48
#   或 PowerShell：[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=

# 部署用（docker-compose.prod.yml）：要啟動的發行版號，對應 docker load 進來的映像標籤（例：0.1.0）。
# 開發環境不用設定；留空時為 0.0.0-local（本機 --build 的映像）
APP_VERSION=
